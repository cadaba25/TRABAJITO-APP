rules_version = '2';

// Reglas de seguridad para Trabajito (MVP).
// Despliegue: Firebase Console → Firestore Database → Rules, o
// `firebase deploy --only firestore:rules`.
service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() {
      return request.auth != null;
    }

    // Campos que un tercero puede tocar en un usuario (rating / conteo / saldo).
    // NOTA: permitir 'saldo' aquí es solo para el prototipo de cartera. En
    // producción los movimientos de dinero deben hacerse en un backend seguro.
    function soloMetricas() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['calificacionPromedio', 'totalCalificaciones',
                  'trabajosCompletados', 'trabajosPublicados',
                  'pagosConfirmados', 'saldo']);
    }

    // ── USUARIOS ──────────────────────────────────────────────
    match /usuarios/{uid} {
      allow read: if autenticado();
      allow create: if autenticado() && request.auth.uid == uid;
      // El dueño edita todo su perfil; otros solo métricas (al calificar/completar/pagar).
      allow update: if autenticado() &&
        (request.auth.uid == uid || soloMetricas());
      allow delete: if autenticado() && request.auth.uid == uid;

      // Tarjetas guardadas: solo el dueño.
      match /tarjetas/{t} {
        allow read, write: if autenticado() && request.auth.uid == uid;
      }
    }

    // ── PUBLICACIONES ─────────────────────────────────────────
    match /publicaciones/{id} {
      allow read: if autenticado();
      allow create: if autenticado() &&
        request.resource.data.uidEmpleador == request.auth.uid;
      // El contratador (dueño) gestiona su trabajo; el trabajador asignado
      // solo puede marcar su bandera de calificación.
      allow update: if autenticado() && (
        resource.data.uidEmpleador == request.auth.uid ||
        // El trabajador asignado avanza su flujo: iniciar / marcar terminado.
        // Solo puede dejar el trabajo 'en_progreso' o 'esperando_confirmacion'
        // (nunca completarlo o liberar el pago) y no toca dinero.
        (resource.data.uidTrabajadorAsignado == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['entregado', 'estado', 'fechaInicio', 'correccionSolicitada']) &&
         request.resource.data.estado in ['en_progreso', 'esperando_confirmacion'] &&
         request.resource.data.montoAcordado == resource.data.montoAcordado &&
         request.resource.data.pagoLiberado == resource.data.pagoLiberado &&
         request.resource.data.pagoRetenido == resource.data.pagoRetenido) ||
        // El trabajador asignado se califica (y, si ambos calificaron, archiva).
        (resource.data.uidTrabajadorAsignado == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['calificadoPorTrabajador', 'estado']) &&
         request.resource.data.estado in ['completado', 'finalizado']) ||
        // El trabajador asignado puede rechazar (reabrir) solo sin escrow.
        (resource.data.uidTrabajadorAsignado == request.auth.uid &&
         resource.data.pagoRetenido == false &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['estado', 'uidTrabajadorAsignado', 'nombreTrabajadorAsignado']))
      );
      allow delete: if autenticado() &&
        resource.data.uidEmpleador == request.auth.uid;

      // ── EVIDENCIAS / AVANCES ────────────────────────────────
      // Ambas partes las leen; solo el trabajador asignado las crea.
      match /evidencias/{ev} {
        allow read: if autenticado() &&
          (get(/databases/$(database)/documents/publicaciones/$(id)).data.uidEmpleador == request.auth.uid ||
           get(/databases/$(database)/documents/publicaciones/$(id)).data.uidTrabajadorAsignado == request.auth.uid);
        allow create: if autenticado() &&
          get(/databases/$(database)/documents/publicaciones/$(id)).data.uidTrabajadorAsignado == request.auth.uid &&
          request.resource.data.autorUid == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // ── POSTULACIONES ─────────────────────────────────────────
    match /postulaciones/{id} {
      allow read: if autenticado() && (
        resource.data.uidTrabajador == request.auth.uid ||
        resource.data.uidEmpleador == request.auth.uid
      );
      allow create: if autenticado() &&
        request.resource.data.uidTrabajador == request.auth.uid;
      // El trabajador retira; el contratador acepta/rechaza.
      allow update: if autenticado() && (
        resource.data.uidTrabajador == request.auth.uid ||
        resource.data.uidEmpleador == request.auth.uid
      );
      // El trabajador puede borrar sus postulaciones (al eliminar su cuenta).
      allow delete: if autenticado() &&
        resource.data.uidTrabajador == request.auth.uid;
    }

    // ── CALIFICACIONES ────────────────────────────────────────
    match /calificaciones/{id} {
      allow read: if autenticado();
      allow create: if autenticado() &&
        request.resource.data.deUid == request.auth.uid;
      allow update, delete: if false;
    }

    // ── CHATS ─────────────────────────────────────────────────
    match /chats/{id} {
      allow read: if autenticado() &&
        request.auth.uid in resource.data.participantes;
      allow create: if autenticado() &&
        request.auth.uid in request.resource.data.participantes;
      allow update: if autenticado() &&
        request.auth.uid in resource.data.participantes;
      allow delete: if false;

      match /mensajes/{m} {
        allow read, create: if autenticado() &&
          request.auth.uid in
            get(/databases/$(database)/documents/chats/$(id)).data.participantes;
        allow update, delete: if false;
      }
    }
  }
}
