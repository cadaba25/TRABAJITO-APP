<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Solo en debug: permite hablar con el backend de pruebas, que hoy va
         por HTTP sin TLS. Ver res/xml/network_security_config.xml y
         docs/development.md → "Apuntar la app al backend". La build de release
         no lleva esto y sigue exigiendo HTTPS. -->
    <application android:networkSecurityConfig="@xml/network_security_config" />
</manifest>
