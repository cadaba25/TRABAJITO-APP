# Copia este archivo a .env y ajusta los valores.
# NUNCA subas el .env real al repositorio (.env ya está en .gitignore).
#
# docker compose lee este .env automáticamente desde backend/.

# ── Base de datos ──
DB_NAME=trabajito
DB_USER=trabajito
DB_PASSWORD=trabajito
# Solo se usa cuando corres el backend FUERA de Docker (IDE / mvn spring-boot:run).
# Dentro de docker compose el host de la BD es el servicio 'db' y el valor lo
# fija docker-compose.yml, no este archivo.
DB_URL=jdbc:postgresql://localhost:5432/trabajito

# ── Seguridad ──
# OBLIGATORIO para levantar el servicio 'api'. Genera un secreto fuerte con:
#   openssl rand -base64 48
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio-de-al-menos-32-bytes
JWT_EXPIRATION_MS=604800000

# ── Administrador inicial (ADR-0005) ──
# El registro público NO puede crear cuentas ADMIN. Esta es la ÚNICA vía
# soportada para crear el primer administrador. Si dejas ambas vacías, el
# backend arranca SIN ningún ADMIN (estado seguro por defecto) y /api/admin/**
# queda inaccesible. La contraseña debe tener al menos 12 caracteres.
# Cámbiala tras el primer acceso; no dejes este valor en un .env compartido.
ADMIN_INICIAL_CORREO=
ADMIN_INICIAL_PASSWORD=

# ── Servidor ──
SERVER_PORT=8080
CORS_ORIGINS=*
UPLOADS_DIR=./uploads

# ── Docker / despliegue ──
# Interfaz:puerto donde se publica cada servicio en el host.
#   "8080"            → escucha en todas las interfaces (0.0.0.0:8080)
#   "127.0.0.1:8080"  → solo accesible desde el propio servidor
API_PORT_BIND=8080
DB_PORT_BIND=127.0.0.1:5432
# Estrategia de esquema de Hibernate: 'update' en desarrollo.
# Cuando existan migraciones (Flyway/Liquibase) esto debe pasar a 'validate'.
JPA_DDL_AUTO=update
# Perfil de Spring. Ya no crea ningún usuario admin (ver
# ADMIN_INICIAL_* arriba). Déjalo VACÍO en cualquier entorno compartido.
SPRING_PROFILES_ACTIVE=

# ── pgAdmin (solo con: docker compose --profile tools up -d pgadmin) ──
# Credenciales para entrar a la interfaz web de pgAdmin en el puerto 5050.
# OJO: pgAdmin valida el correo y RECHAZA dominios reservados como `.local`
# (el contenedor entra en bucle de reinicio). Usa un TLD normal.
PGADMIN_EMAIL=admin@trabajito.com
PGADMIN_PASSWORD=admin
