# Copia este archivo a .env y ajusta los valores.
# NUNCA subas el .env real al repositorio.

# ── Base de datos ──
DB_NAME=trabajito
DB_USER=trabajito
DB_PASSWORD=trabajito
DB_URL=jdbc:postgresql://localhost:5432/trabajito

# ── Seguridad ──
# Genera un secreto fuerte con:  openssl rand -base64 48
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio-de-al-menos-32-bytes
JWT_EXPIRATION_MS=604800000

# ── Servidor ──
SERVER_PORT=8080
CORS_ORIGINS=*
UPLOADS_DIR=./uploads
